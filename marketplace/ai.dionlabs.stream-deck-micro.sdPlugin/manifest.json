{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Stream Deck Micro",
  "Version": "0.1.0.2",
  "Author": "Dion Labs",
  "UUID": "ai.dionlabs.stream-deck-micro",
  "Description": "Control shared Codex sessions, see live agent state, and launch workflows from Stream Deck.",
  "Category": "Stream Deck Micro",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "URL": "https://deck.dionlabs.ai",
  "SupportURL": "https://github.com/dion-labs/stream-deck-micro/issues",
  "Actions": [
    {
      "Name": "Surface Key",
      "UUID": "ai.dionlabs.stream-deck-micro.surface-key",
      "Icon": "imgs/actions/surface/icon",
      "Tooltip": "A position-aware key for the Stream Deck Micro 5×3 surface.",
      "PropertyInspectorPath": "ui/surface-key.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/surface/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/Stream Deck Micro",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": false,
      "AutoInstall": true
    }
  ]
}